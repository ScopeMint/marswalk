{
  "name": "MarsWalk — EVA Planner",
  "short_name": "MarsWalk",
  "description": "Plan a safe Marswalk on Curiosity's real boxwork route at Gale Crater: HiRISE 1 m terrain, slope-aware routes, suit consumables, radiation, Mars clock. Works offline.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0F1115",
  "theme_color": "#0F1115",
  "categories": ["education", "navigation", "utilities"],
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
